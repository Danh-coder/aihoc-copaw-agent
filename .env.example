# RAG demo environment variables
# Database
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/qwenpaw

# Google Generative AI for embeddings (https://ai.google.dev)
# Get your API key from: https://aistudio.google.com/app/apikey
EMBEDDING_API_KEY=your-google-api-key-here

# Vector database (qrandt)
QRANDT_API_URL=http://qrandt:8000
QRANDT_API_KEY=

# Data storage
RAG_DATA_DIR=qwenpaw-data/sources

# Zalo channel credentials (existing)
ZALO_IMEI=your-imei-here
ZALO_COOKIES={}